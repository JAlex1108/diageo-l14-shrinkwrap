# --- Virtual environments ---
diageo_env/
.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# --- Video source + clips (large binaries — never commit) ---
*.ts
*.mp4
*.avi
*.mkv
*.mov
*.webm

# --- Generated pipeline outputs / artefacts ---
# Every analysis folder keeps its generated artefacts in its own output/ folder.
# (Tracked result images that were git-mv'd into an output/ folder stay tracked —
# gitignore only hides new files.)
output/
*.zip

# --- Stoppage detection/classification local artefacts ---
# Keep the workflow notebooks in Git, but keep copied datasets, trained models,
# generated results, reference assets, and downloaded media local.
stoppage_detection_and_classification/**/data/
stoppage_detection_and_classification/**/models/
stoppage_detection_and_classification/**/output/

# --- Large ML/data binaries ---
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.tflite
*.safetensors
*.joblib
*.pkl
*.pickle
*.npz
*.npy
*.h5
*.hdf5
*.parquet
*.feather
*.cache

# --- Archives and compressed datasets ---
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz

# NOTE: AnomalyDetection/phase_anchor_41884872.png is intentionally NOT ignored — the
# anomaly script needs it, so it is tracked (only ~1.8 MB).

# --- Raw data / example footage ---
ShrinkWrapClassification/failure_mode_examples/

# --- DataFiles ---
docs/tasks/*
*.csv
*.pdf

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
